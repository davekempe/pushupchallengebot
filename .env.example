# Your team's fundraiser slug (the bit after /fundraisers/ in the page URL),
# or paste the full URL — both work. Find it at:
#   https://www.thepushupchallenge.com.au/fundraisers/<YOUR-TEAM>
PUSHUP_TEAM=YourTeamSlug

# Slack incoming-webhook URL for the channel you want updates posted to.
PUSHUP_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Optional: override the team display name (otherwise read from the page title).
# PUSHUP_TEAM_NAME=Your Team Name
